{
  "name": "AI Mouse",
  "slug": "ai-mouse",
  "version": "0.11.0",
  "description": "Minimalistische lokale Windows-muisrecorder met compact monitoroverzicht en een zelfgespeelde Aim Lab.",
  "preview": "docs/previews/latest.svg",
  "start_command": "Start AI Mouse Hub.bat",
  "secondary_commands": [
    "Start Aim Lab Test.bat"
  ],
  "default_port": 0,
  "health_url": "",
  "platform": "windows",
  "capabilities": [
    "global-mouse-tracking",
    "mouse-button-down-up",
    "click-hold-duration",
    "multi-monitor-overview",
    "active-monitor-visualization",
    "record-stop-play",
    "open-recordings-folder",
    "human-played-aim-lab",
    "circle-square-triangle-targets",
    "target-size-distance-randomness",
    "overshoot-and-corrections",
    "accuracy-and-click-timing",
    "local-action-analytics"
  ],
  "privacy": {
    "local_only": true,
    "keyboard_recording": false,
    "typed_text_recording": false,
    "screenshots": false,
    "external_app_control": false
  }
}
