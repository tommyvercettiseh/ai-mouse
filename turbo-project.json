{
  "name": "AI Mouse Lab",
  "slug": "ai-mouse",
  "version": "1.2.0",
  "description": "Lokale persoonlijke muisrecorder met geïntegreerde Aim Lab, Gaming 360°, fail-closed raw-inputkwaliteit en gescheiden gedragsprofielen.",
  "preview": "docs/previews/latest.svg",
  "start_command": "Start Project.bat",
  "secondary_commands": [
    {
      "name": "AI Mouse Lab",
      "command": "Start AI Mouse Lab.bat"
    },
    {
      "name": "Aim Lab compatibility launcher",
      "command": "Start Aim Lab.bat",
      "pid_file": "data/runtime/aim-lab.pid"
    }
  ],
  "default_port": 0,
  "health_url": "",
  "health_command": ".venv\\Scripts\\python.exe -m ai_mouse_lab.healthcheck",
  "pid_file": "data/runtime/ai-mouse-lab.pid",
  "log_file": "data/logs/app.log",
  "launcher_log": "data/logs/launcher.log",
  "platform": "windows",
  "app_type": "desktop",
  "requires_terminal": false,
  "profile_schema": 3,
  "integrated_pages": [
    "dashboard",
    "aim_lab",
    "gaming_360"
  ],
  "features": {
    "fading_trace": true,
    "stoppable_trace_playback": true,
    "profile_replay": true,
    "click_hold_profile": true,
    "scroll_profile_separate": true,
    "raw_input_gaming": true,
    "raw_input_quality_gate": true,
    "atomic_session_storage": true,
    "environment_snapshot": true,
    "quality_weighted_profile": true
  },
  "data_directories": [
    "data/recordings",
    "data/aim_lab",
    "data/profiles",
    "data/logs",
    "data/runtime"
  ],
  "privacy": {
    "local_only": true,
    "keyboard_recording": false,
    "typed_text_recording": false,
    "screenshots": false,
    "external_app_control": false
  },
  "stop_command": "Stop Project.bat"
}